  "posts": [
    { "id": "d1_yoru_strike", "account": "yoru_cam", "day": 1, "time": "23:10", "provisional": true,
      "text": "第八码頭、夜の荷役が止まったらしい。港の灯りがいつもより暗い気がする。明日ちょっと見に行ってみる。" },
    { "id": "d2_yoru_checkpoint", "account": "yoru_cam", "day": 2, "time": "19:30", "provisional": true,
      "text": "検問できてた。カメラ向けたら手で払われた。ただの荷物の話なのに、なんでこんなにピリピリしてるんだろ。" },
    { "id": "d2_yoru_hungry", "account": "yoru_cam", "day": 2, "time": "02:15", "provisional": true,
      "text": "深夜の腹ペコ。屋台のスープは、とろっとしてて、噛みごたえのある具が入ってるのが最強説。海老が入ってたら優勝。" },
    { "id": "d3_yoru_rain", "account": "yoru_cam", "day": 3, "time": "18:40", "provisional": true,
      "text": "雨。機材が濡れるから今日の撮影はおやすみ。かわりに噂だけ置いとく。夜中に倉庫から何か運び出してる奴がいるって。トラックの音を聞いた人が三人。" },
    { "id": "d3_dock_reply", "account": "dock", "day": 3, "time": "19:05", "reply_to": "d3_yoru_rain", "provisional": true,
      "text": "見てもいねえのに書くな。" },
    { "id": "d4_yoru_video", "account": "yoru_cam", "day": 4, "time": "11:20", "provisional": true,
      "text": "回ってる码頭の動画、元は自分のやつ。知らない人たちのところで再生数がすごいことになってる。……なのに元の投稿が消えてる。消した覚えはない。" },
    { "id": "d4_passer1_reply", "account": "passer1", "day": 4, "time": "11:42", "reply_to": "d4_yoru_video", "provisional": true,
      "text": "本人？" },
    { "id": "d4_yoru_stall", "account": "yoru_cam", "day": 4, "time": "17:50", "provisional": true,
      "text": "今夜は前から気になってた屋台へ。配信の前に腹ごしらえ。" },
    { "id": "d4_yoru_ate", "account": "yoru_cam", "day": 4, "time": "22:30", "requires": { "met": "streamer" }, "provisional": true,
      "text": "屋台で一杯。カメラを回さずに食べるの、なんか落ち着かない。でも、うまかった。" },
    { "id": "d5_yoru_company", "account": "yoru_cam", "day": 5, "time": "20:00", "provisional": true,
      "text": "運営会社が変わるかもってニュース。ほら、搬出の噂とつながってない？ つながってないかもしれないけど。" },
    { "id": "d5_yoru_stopped", "account": "yoru_cam", "day": 5, "time": "23:30", "photo": "ぶれた夜の倉庫の壁", "provisional": true,
      "text": "码頭の裏で撮ってたら止められた。止めた人、警備の制服じゃなかった。じゃあ誰？" },
    { "id": "d5_noise_shrimp", "account": "noise", "day": 5, "time": "05:10", "provisional": true,
      "text": "屋台の海老、反則。誰にも言ってない話まで、しゃべった気がする。" },
    { "id": "d6_yoru_forced", "account": "yoru_cam", "day": 6, "time": "19:20", "provisional": true,
      "text": "今夜、強行搬出があるって情報が回ってる。行くべき？ 行かないべき？" },
    { "id": "d6_yoru_fire", "account": "yoru_cam", "day": 6, "time": "21:05", "provisional": true,
      "text": "空が赤い。サイレン。码頭のほう。" },
    { "id": "d6_passer2_reply", "account": "passer2", "day": 6, "time": "21:09", "reply_to": "d6_yoru_fire", "provisional": true,
      "text": "うちの窓からも見える" },
    { "id": "d6_noise_deleted", "account": "noise", "day": 6, "time": "23:40", "provisional": true,
      "text": "さっきの投稿は消した。撮りに行かなかった。行かなかったのが正しかったのか、分からない。" },
    { "id": "d7_yoru_apology", "account": "yoru_cam", "day": 7, "time": "12:00", "provisional": true,
      "text": "お詫び。これまで投稿してきた倉庫の噂は、ガセでした。不確かな情報で騒がせてすみません。" },
    { "id": "d7_passer1_reply", "account": "passer1", "day": 7, "time": "12:10", "reply_to": "d7_yoru_apology", "provisional": true,
      "text": "結局なんだったの" },
    { "id": "d7_passer2_reply", "account": "passer2", "day": 7, "time": "12:14", "reply_to": "d7_yoru_apology", "provisional": true,
      "text": "消されたんじゃね" },
    { "id": "d7_yoru_tonight", "account": "yoru_cam", "day": 7, "time": "18:00", "provisional": true,
      "text": "今夜は、あの屋台で一杯食べてから考える。" },
    { "id": "d7_noise_retract", "account": "noise", "day": 7, "time": "23:50", "provisional": true,
