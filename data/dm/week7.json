{
  "id": "week7",
  "provisional_note": "本文はすべて仮（provisional）。チャット側で差し替える。差し替えるときは text だけ直せばよい。形・条件・hint は変えない（変えるときはデータのテストが矛盾を弾く）。",
  "hints": {
	"many": { "demand_word": "多め" },
	"few": { "demand_word": "少ない" }
  },
  "days": {
	"2": [
	  { "id": "d2_market", "from": "張姐", "from_kind": "npc", "time": "6:40",
		"text": "豚骨、今日は着くのが遅れる。検問だってさ。来る時間は変えなくていいよ", "hint": "none", "provisional": false },
	  { "id": "d2_delivery_man", "from": "阿強", "from_kind": "customer", "requires": { "customer": "delivery_man" }, "if": { "fact": "day1_takeout_served" }, "time": "5:50",
		"text": "昨日の容器、門のおっさんに預けてきた。返ってきたら持ってく", "hint": "none", "provisional": false },
	  { "id": "d2_thug_1", "from": "レックス", "from_kind": "customer", "requires": { "customer": "thug" }, "time": "4:40",
		"text": "昨日あのあと兄貴に呼ばれた。焼肉だ。俺の皿に乗ったのは玉ねぎ一枚。", "hint": "none", "provisional": false },
	  { "id": "d2_thug_2", "from": "レックス", "from_kind": "customer", "requires": { "customer": "thug" }, "time": "4:42",
		"text": "今夜は客で行く。帳面は持ってかねえ。丸いの、取っとけ。", "hint": "none", "provisional": false }
	],
	"3": [
	  { "id": "d3_market", "from": "張姐", "from_kind": "npc", "time": "6:35",
		"text": "雨だけど骨は届いてるよ。いつもどおりおいで。濡れた袋のまま持って帰らせないからね。", "hint": "none", "provisional": false },
	  { "id": "d3_delivery_man", "from": "阿強", "from_kind": "customer", "requires": { "customer": "delivery_man" }, "if": { "fact": "day1_takeout_served" }, "time": "7:10",
		"text": "門のおっさんが容器洗っといたって。今夜持ってく。雨だと次いつ休めるか読めないから、腹にたまるやつ頼む。", "hint": "none", "provisional": false },
	  { "id": "d3_delivery_man_declined", "from": "阿強", "from_kind": "customer", "requires": { "customer": "delivery_man" }, "if": { "not_fact": "day1_takeout_served" }, "time": "7:10",
		"text": "今夜寄る。雨だと次いつ休めるか読めないから、腹にたまるやつ頼む。", "hint": "none", "provisional": false },
	  { "id": "d3_hooker", "from": "セティヤ", "from_kind": "customer", "requires": { "customer": "hooker" }, "time": "7:45",
		"text": "今夜、帰りに寄るわ。こういう雨の日は冷えるのよね。あんたの鍋の前を、少し空けといて。", "hint": "none", "provisional": false }
	],
	"4": [
	  { "id": "d4_market", "from": "張姐", "from_kind": "npc", "time": "6:35",
		"text": "雨は上がったけど、袋は昨日のまま使わないでね。底も見なよ。骨は届いてるから、いつもどおりおいで。", "hint": "none", "provisional": false },
	  { "id": "d4_officer", "from": "リン", "from_kind": "customer", "requires": { "customer": "officer" }, "time": "7:10",
		"text": "今夜、休憩で寄ります。前に頼んだ酸っぱい汁を、歩いていると時々思い出します。米の麺があれば、うれしいです。今日は市場の正面へは行きません。", "hint": "none", "provisional": false },
	  { "id": "d4_delivery_man", "from": "阿強", "from_kind": "customer", "requires": { "customer": "delivery_man" }, "time": "7:40",
		"text": "今夜寄る。昨日の仕事、話すことある。今日はいつもの肉の方で頼む。雨の日の腹もちも助かったけど、そろそろ戻したい。", "hint": "none", "provisional": false },
	  { "id": "d4_granny", "from": "ターニャ婆", "from_kind": "customer", "requires": { "customer": "granny" }, "time": "8:05",
		"text": "今夜、明るくなる前に寄るよ。瓶はまだそのまま取っといておくれ。濡れてるうちは箱にしまわないでね。", "hint": "none", "provisional": false }
	],
	"5": [
	  { "id": "d5_market", "from": "張姐", "from_kind": "npc", "time": "6:35",
		"text": "骨は届いてるよ。今日は空箱を片づけながらだから、通りの真ん中に袋を置かないでね。呼べば出るから。", "hint": "none", "provisional": false },
	  { "id": "d5_hooker", "from": "セティヤ", "from_kind": "customer", "requires": { "customer": "hooker" }, "time": "7:05",
		"text": "今夜は出勤前に寄るわ。苦い方に戻してね。仕事の話をする前に、自分の夕飯を済ませたいの。", "hint": "none", "provisional": false },
	  { "id": "d5_streamer", "from": "ニカ", "from_kind": "customer", "requires": { "customer": "streamer" }, "time": "7:35",
		"text": "今夜、また食べに行く。昨日撮れたの、ちょっと見てもらいたい。今度は白い汁を冷ます前に食べる。たぶん。", "hint": "none", "provisional": false },
	  { "id": "d5_officer", "from": "リン", "from_kind": "customer", "requires": { "customer": "officer" }, "time": "8:00",
		"text": "今夜の勤務が終わったら寄ります。明るくなる前になると思います。前の酸っぱい汁を、もう一度お願いします。", "hint": "none", "provisional": false }
	],
	"6": [
	  { "id": "d6_market", "from": "張姐", "from_kind": "npc", "time": "6:35",
		"text": "今日の骨は着いてる。明日の便は受け取る口を確認してるから、今日は今日の分で考えておいで。うちの売り場はいつもの所だよ。", "hint": "none", "provisional": false },
	  { "id": "d6_hooker", "from": "セティヤ", "from_kind": "customer", "requires": { "customer": "hooker" }, "time": "7:10",
		"text": "今夜も出勤前に寄るわ。苦い方と、少しいい具で。昨日の話は一応まとまった。食べながら話す。", "hint": "none", "provisional": false },
	  { "id": "d6_streamer", "from": "ニカ", "from_kind": "customer", "requires": { "customer": "streamer" }, "time": "7:40",
		"text": "今夜も行く。公開されてる依頼を見つけた。昨日の映像と並べてみたい。ご飯も食べる。そっちは忘れてない。", "hint": "none", "provisional": false },
	  { "id": "d6_zhang_0218", "from": "張姐", "from_kind": "npc", "time": "02:18", "after_event": "d6_fire",
		"text": "港の火事、見た？　明日の骨の車、いったん動けないって連絡が来た。骨が焼けたって話じゃないよ。積み替える口と、通る道がまだ分からないの。", "hint": "none", "provisional": false },
	  { "id": "d6_zhang_0220", "from": "張姐", "from_kind": "npc", "time": "02:20", "after_event": "d6_fire",
		"text": "着く時刻は言えなくなった。うちで冷やしてる分も確かめる。まだ約束はできないから、明日の支度を増やさず待ってて。分かったら送る。", "hint": "none", "provisional": false },
	  { "id": "d6_liang_0226", "from": "梁伯", "from_kind": "npc", "time": "02:26", "after_event": "d6_fire",
		"text": "市場の水は今のところ出とる。だからといって、港側から取りに来るな。途中の通りが止められとる。残ってる分は、こぼさず使いな。通れる口が分かってから動くんだよ。", "hint": "none", "provisional": false },
	  { "id": "d6_hooker_0234", "from": "セティヤ", "from_kind": "customer", "requires": { "customer": "hooker" }, "time": "02:34", "after_event": "d6_fire",
		"text": "私は店の中。帰りに使うつもりだった裏の道、今は出ないでって言われた。靴もまだ履き替えてない。あんたの方は無事？", "hint": "none", "provisional": false },
	  { "id": "d6_hooker_0236", "from": "セティヤ", "from_kind": "customer", "requires": { "customer": "hooker" }, "time": "02:36", "after_event": "d6_fire",
		"text": "無理にこっちへ来なくていいからね。今夜の「あとでね」、まだ使えそうにないわ。", "hint": "none", "provisional": false },
	  { "id": "d6_dock_0305", "from": "港湾労働者", "from_kind": "npc", "time": "03:05", "after_event": "d6_dawn",
		"text": "これ、見た？　さすがに放火はねえだろって思うんだけど。窓口が替わって、上に門までできて、この時に燃えるのかよ。誰か知ってる？\n（転送）露出調整中「旧倉庫の火事、事故で片づけないでほしい。新しい窓口の担当者と、この組の幹部が会っていた。新名義の依頼が出始めた時期に、旧倉庫への搬入も増えている。火をつけるところを見た人がいるって話も来てる。仕事を新しい契約へ移して得をするこの人が、焼かせたんだ。」", "photo": "事務所の前で話す二人。顔はぼかし。赤茶と金の上着は見える", "hint": "none", "provisional": false },
	  { "id": "d6_dock_0312", "from": "港湾労働者", "from_kind": "npc", "time": "03:12", "after_event": "d6_dawn",
		"text": "班の連絡は「立入禁止」だけ来た。俺、明日どこへ行けばいいのかも分かんねえ。卵、買っといてよかった。", "hint": "none", "provisional": false },
	  { "id": "d6_hai_0340", "from": "海隆鮮貨", "from_kind": "npc", "time": "03:40", "after_event": "d6_dawn",
		"text": "今朝の魚、受け取る場所が決まってない。今日は入らない、ともまだ言えない。冷やしたままどこまで運べるか、確かめてる。取りに来る前に連絡して。空の箱だけ持って待たせたくないからね。", "hint": "none", "provisional": false },
	  { "id": "d6_zhang_0455", "from": "張姐", "from_kind": "npc", "time": "04:55", "after_event": "d6_close",
		"text": "こっちも、まだ確認してる。分かったら送る。まず帰って休みな。", "hint": "none", "provisional": false }
	],
	"7": [
	  { "id": "d7_market", "from": "市場の顔なじみ", "from_kind": "npc", "time": "6:50",
		"text": "第八码頭は当面封鎖。魚は入らない", "hint": "none", "provisional": true }
	]
  },
  "previews": {
	"_note": "来店予告（UI準備E）。その夜に来る予定の客・モブの種類を朝のDMで知らせる。texts は本番の本文（UI準備E2）。from・from_kind・time は仮（差し替えるときはデータだけ直す）。本文の {hint} は tag_hint（モブの好み2つのうち1つ）の言葉に置き換わる。名前あり客は tag_hint を持たない。名前あり客の予告は、その客がもう来たことがある朝だけ出す（店主がまだ会っていない客から予告は来ない。中身X）。before_first_visit:true の客（セティヤ。店主とは前からの付き合い）は初来店の前の朝にも出す。本文に数字と「客足」は入れない。",
	"max_per_morning": 3, "mob_max": 2, "first_day": 2,
	"pools": {
	  "delivery_man": { "from": "阿強", "from_kind": "customer", "no_preview_days": [3, 4], "time": "4:50", "tag_hint": "", "provisional": false,
		"texts": ["今夜、配達の帰りに寄る予定だ", "夜に顔出すかもな。腹すかせて行くぜ"] },
	  "thug": { "from": "レックス", "from_kind": "customer", "time": "4:40", "tag_hint": "", "provisional": false,
		"texts": ["……今夜、寄るかもしれん。それだけだ", "夜、顔を出す。たぶんな"] },
	  "granny": { "from": "ターニャ婆", "from_kind": "customer", "no_preview_days": [4], "time": "4:30", "tag_hint": "", "provisional": false,
		"texts": ["今夜あたり、寄らせてもらおうかね", "夜に顔を出すよ。待っておくれ"] },
	  "officer": { "from": "新人警官", "from_kind": "customer", "no_preview_days": [4, 5], "time": "4:55", "tag_hint": "", "provisional": false,
		"texts": ["今夜、巡回のあとに寄る予定です", "夜、顔を出すかもしれません。お邪魔でなければ"] },
	  "hooker": { "from": "セティヤ", "from_kind": "customer", "no_preview_days": [3, 5, 6], "time": "4:45", "tag_hint": "", "provisional": false, "before_first_visit": true,
		"texts": ["今夜、仕事が早く済んだら寄るわ", "夜、顔を出すかも。一杯だけね"] },
	  "streamer": { "from": "配信者", "from_kind": "customer", "no_preview_days": [5, 6], "time": "4:35", "tag_hint": "", "provisional": false,
		"texts": ["今夜、配信の前に寄る予定です〜！", "夜、顔出すかもです！よろしく〜"] },
	  "dock_workers": { "from": "港湾労働者の組", "from_kind": "mob", "time": "4:20", "tag_hint": "POWER", "provisional": false,
		"texts": ["港の連中、夜に寄る予定だ。{hint}のつくもんを頼むぞ", "仕事のあと、顔を出すかもしれん。{hint}がつくやつを頼む"] },
	  "general_store_clerk": { "from": "雑貨屋の夜番", "from_kind": "mob", "time": "4:25", "tag_hint": "BITTER", "provisional": false,
		"texts": ["店番の合間に寄る予定。{hint}のが好きでね", "夜、覗きに行くかもしれん。{hint}ものが食いたい気分だ"] },
	  "inn_clerk": { "from": "安宿の夜勤受付", "from_kind": "mob", "time": "4:15", "tag_hint": "MELLOW", "provisional": false,
		"texts": ["受付が空いたら寄る予定です。{hint}なものが飲みたいです", "夜、顔を出すかもしれません。{hint}なのをお願いします"] },
	  "laundry_night": { "from": "港のホテルの夜番", "from_kind": "mob", "time": "4:10", "tag_hint": "GENTLE", "provisional": true,
		"texts": ["お客が寝静まったら寄る予定です。{hint}のを一杯", "夜、呼び出しが途切れたら顔を出すかも。{hint}なのがいいな"] },
	  "long_haul_driver": { "from": "長距離運転手の仲間", "from_kind": "mob", "time": "4:10", "tag_hint": "TREAT", "provisional": false,
		"texts": ["走り終えたら寄る予定だ。たまには{hint}っぽいのが食いたい", "夜に顔を出すかもな。{hint}を頼むかもしれん"] },
	  "market_porter": { "from": "市場の荷捌き仲間", "from_kind": "mob", "time": "4:05", "tag_hint": "FILLING", "provisional": false,
		"texts": ["荷が片付いたら寄る予定だ。{hint}のいいやつ頼む", "俺たち、夜に顔を出すぜ。{hint}がいいもんを頼む"] },
	  "security_guard": { "from": "夜勤警備員の詰所", "from_kind": "mob", "time": "4:00", "tag_hint": "BITE", "provisional": false,
		"texts": ["交代の合間に寄る予定です。{hint}のあるものを", "夜、顔を出すかもしれません。{hint}があると嬉しいです"] },
	  "street_cleaners": { "from": "清掃員の組", "from_kind": "mob", "time": "3:55", "tag_hint": "SOUR", "provisional": false,
		"texts": ["掃除のあと寄る予定よ。{hint}ものでさっぱりしたいわ", "夜に顔を出すかも。{hint}のが食べたいねえ"] }
	}
  }
}
