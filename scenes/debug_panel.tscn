[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/debug_panel.gd" id="1"]
[ext_resource type="Script" path="res://scripts/flow_controller.gd" id="2"]

[node name="DebugPanel" type="PanelContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 16

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="Margin/VBox"]
layout_mode = 2
text = "STATE VIEWER (STEP 1)"

[node name="TextScroll" type="ScrollContainer" parent="Margin/VBox"]
custom_minimum_size = Vector2(0, 80)
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="TextBox" type="VBoxContainer" parent="Margin/VBox/TextScroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="GameStateLabel" type="Label" parent="Margin/VBox/TextScroll/TextBox"]
layout_mode = 2
text = "GameState:"

[node name="RunnerLabel" type="Label" parent="Margin/VBox/TextScroll/TextBox"]
layout_mode = 2
text = "EventRunner:"

[node name="HSep" type="HSeparator" parent="Margin/VBox"]
layout_mode = 2

[node name="EventRow" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="BtnNextEvent" type="Button" parent="Margin/VBox/EventRow"]
layout_mode = 2
text = "次のEvent"

[node name="BtnCompleteInput" type="Button" parent="Margin/VBox/EventRow"]
layout_mode = 2
text = "入力完了"

[node name="OptionsRow" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="PhaseRow" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="BtnNextPhase" type="Button" parent="Margin/VBox/PhaseRow"]
layout_mode = 2
text = "次のPhase"

[node name="BtnDayPlus" type="Button" parent="Margin/VBox/PhaseRow"]
